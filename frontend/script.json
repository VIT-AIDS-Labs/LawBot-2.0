      answer += `Illustration from a similar fact pattern:\n• ${top.text}\n\n`;
      answer += `Confidence: <b>${top.confidence}</b> `
              + `(similarity score ≈ ${Number(top.score).toFixed(2)}).\n`;

      if (others.length > 0) {
        answer += `\nOther similar examples in our dataset:\n`;
        for (const ex of others) {
          answer += `• ${ex.text}\n`;
        }
      }

      addMessage(answer, "bot");
    } catch (err) {
      console.error(err);
      thinkingDiv.remove();
      addMessage(
