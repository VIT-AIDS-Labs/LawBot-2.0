    });

    userInput.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        void sendMessage();
      }
    });
  }

  // for inline call from HTML if needed
  window.initChat = function () {
    // nothing needed right now; kept for compatibility
  };
})();

  });
}

